{
  "setup": {
    "global": [
      "make all",
      "make inputs",
      "make inputs-large"
    ]
  },
  "space": {
    "solver": [
      "tropical_exact",
      "tropical_apx",
      "cusparse",
      "cugraph"
    ],
    "graph": [
      {
        "name": "amazon0601",
        "value": "data/amazon0601.csrbin",
        "attrs": {
          "source": 57330
        }
      },
      {
        "name": "email_euall",
        "value": "data/email-EuAll.csrbin",
        "attrs": {
          "source": 75795
        }
      },
      {
        "name": "roadnet_ca",
        "value": "data/roadNet-CA.csrbin",
        "attrs": {
          "source": 982529
        }
      },
      {
        "name": "roadnet_pa",
        "value": "data/roadNet-PA.csrbin",
        "attrs": {
          "source": 319360
        }
      },
      {
        "name": "roadnet_tx",
        "value": "data/roadNet-TX.csrbin",
        "attrs": {
          "source": 900309
        }
      },
      {
        "name": "livejournal",
        "value": "data/soc-LiveJournal1.csrbin",
        "attrs": {
          "source": 3487746
        }
      },
      {
        "name": "soc_pokec_relationships",
        "value": "data/soc-pokec-relationships.csrbin",
        "attrs": {
          "source": 1236350
        }
      },
      {
        "name": "orkut",
        "value": "data/com-orkut.ungraph.csrbin",
        "attrs": {
          "source": 1
        }
      },
      {
        "name": "web_berkstan",
        "value": "data/web-BerkStan.csrbin",
        "attrs": {
          "source": 598568
        }
      },
      {
        "name": "web_google",
        "value": "data/web-Google.csrbin",
        "attrs": {
          "source": 461148
        }
      },
      {
        "name": "web_notredame",
        "value": "data/web-NotreDame.csrbin",
        "attrs": {
          "source": 251608
        }
      },
      {
        "name": "web_stanford",
        "value": "data/web-Stanford.csrbin",
        "attrs": {
          "source": 7039
        }
      },
      {
        "name": "wiki_talk",
        "value": "data/wiki-Talk.csrbin",
        "attrs": {
          "source": 2161385
        }
      }
    ]
  },
  "trials": [
    {
      "command": "${yuclid.workspace}/build/sssp ${yuclid.graph} --source ${yuclid.graph.source} --solver ${yuclid.solver} --runs 1 --error",
      "repeats": false,
      "metrics": [
        "setup",
        "download",
        "kernel",
        "end_to_end",
        "lost",
        "spurious",
        "overestimates",
        "rel_error_mean",
        "rel_error_p99",
        "exact"
      ]
    },
    {
      "command": "${yuclid.workspace}/build/sssp ${yuclid.graph} --source ${yuclid.graph.source} --solver ${yuclid.solver} --runs ${yuclid.repeat}",
      "repeats": true,
      "metrics": [
        "kernel"
      ]
    }
  ],
  "metrics": {
    "setup": "grep -E '^\\[scoped_timer\\] setup:' ${yuclid.@}.out | awk '{print $3}'",
    "kernel": "grep -E '^\\[scoped_timer\\] kernel:' ${yuclid.@}.out | awk '{print $3}'",
    "download": "grep -E '^\\[scoped_timer\\] download:' ${yuclid.@}.out | awk '{print $3}'",
    "end_to_end": "grep -E '^\\[scoped_timer\\] end_to_end:' ${yuclid.@}.out | awk '{print $3}'",
    "lost": "grep -E '^lost:' ${yuclid.@}.out | awk '{print $2}'",
    "spurious": "grep -E '^spurious:' ${yuclid.@}.out | awk '{print $2}'",
    "overestimates": "grep -E '^overestimates:' ${yuclid.@}.out | awk '{print $2}'",
    "rel_error_mean": "grep -E '^rel_error_mean:' ${yuclid.@}.out | awk '{print $2}'",
    "rel_error_p99": "grep -E '^rel_error_p99:' ${yuclid.@}.out | awk '{print $2}'",
    "exact": "grep -E '^exact:' ${yuclid.@}.out | awk '{print $2}'"
  },
  "order": [
    "graph",
    "solver"
  ]
}