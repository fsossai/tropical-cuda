      },
      {
        "name": "wiki_talk",
        "value": "data/wiki-Talk.csrbin"
      }
    ],
    "solver": [
      "tropical_exact",
      "tropical_apx",
      "cusparse",
      "cugraph"
    ],
    "repetitions": null
  },
  "trials": "${yuclid.workspace}/build/sssp ${yuclid.input_graph} --algorithm ${yuclid.solver} --repetitions ${yuclid.repetitions}",
  "metrics": {
    "setup": "grep -E '^\\[scoped_timer\\] setup:' ${yuclid.@}.out | awk '{print $3}'",
    "kernel": "grep -E '^\\[stopwatch\\] kernel:' ${yuclid.@}.out | awk '{print $3}'",
    "download": "grep -E '^\\[scoped_timer\\] download:' ${yuclid.@}.out | awk '{print $3}'",
    "end_to_end": "grep -E '^\\[scoped_timer\\] end_to_end:' ${yuclid.@}.out | awk '{print $3}'"
  },
  "order": [
    "input_graph",
    "solver",
    "repetitions"
  ]
}