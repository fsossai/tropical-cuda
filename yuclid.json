{
  "setup": {
    "global": [
      "make all",
      "make inputs",
      "make inputs-large"
    ]
  },
  "space": {
    "graph": [
      {
        "name": "amazon0601",
        "value": "data/amazon0601.csrbin --source 402568"
      },
      {
        "name": "email_euall",
        "value": "data/email-EuAll.csrbin --source 70445"
      },
      {
        "name": "roadnet_ca",
        "value": "data/roadNet-CA.csrbin --source 1253170"
      },
      {
        "name": "roadnet_pa",
        "value": "data/roadNet-PA.csrbin --source 93526"
      },
      {
        "name": "roadnet_tx",
        "value": "data/roadNet-TX.csrbin --source 198933"
      },
      {
        "name": "livejournal",
        "value": "data/soc-LiveJournal1.csrbin --source 4774828"
      },
      {
        "name": "soc_pokec_relationships",
        "value": "data/soc-pokec-relationships.csrbin --source 1193707"
      },
      {
        "name": "friendster",
        "value": "data/com-friendster.ungraph.csrbin"
      },
      {
        "name": "orkut",
        "value": "data/com-orkut.ungraph.csrbin"
      },
      {
        "name": "web_berkstan",
        "value": "data/web-BerkStan.csrbin --source 267459"
      },
      {
        "name": "web_google",
        "value": "data/web-Google.csrbin --source 649930"
      },
      {
        "name": "web_notredame",
        "value": "data/web-NotreDame.csrbin --source 133729"
      },
      {
        "name": "web_stanford",
        "value": "data/web-Stanford.csrbin --source 133729"
      },
      {
        "name": "wiki_talk",
        "value": "data/wiki-Talk.csrbin --source 3215"
      }
    ],
    "solver": [
      "tropical_exact",
      "tropical_apx",
      "cusparse",
      "cugraph"
    ]
  },
  "trials": [
    {
      "command": "${yuclid.workspace}/build/sssp ${yuclid.graph} --solver ${yuclid.solver} --runs ${yuclid.repeat}",
      "repeats": true
    }
  ],
  "metrics": {
    "setup": "grep -E '^\\[scoped_timer\\] setup:' ${yuclid.@}.out | awk '{print $3}'",
    "kernel": "grep -E '^\\[scoped_timer\\] kernel:' ${yuclid.@}.out | awk '{print $3}'",
    "download": "grep -E '^\\[scoped_timer\\] download:' ${yuclid.@}.out | awk '{print $3}'",
    "end_to_end": "grep -E '^\\[scoped_timer\\] end_to_end:' ${yuclid.@}.out | awk '{print $3}'"
  },
  "order": [
    "graph",
    "solver"
  ]
}
