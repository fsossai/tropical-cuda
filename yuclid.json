      },
      {
        "name": "roadnet_pa",
        "value": "data/roadNet-PA.csrbin"
      },
      {
        "name": "roadnet_tx",
        "value": "data/roadNet-TX.csrbin"
      },
      {
        "name": "livejournal",
        "value": "data/soc-LiveJournal1.csrbin"
      },
      {
        "name": "soc_pokec_relationships",
        "value": "data/soc-pokec-relationships.csrbin"
      },
      {
        "name": "web_berkstan",
        "value": "data/web-BerkStan.csrbin"
      },
      {
        "name": "web_google",
        "value": "data/web-Google.csrbin"
      },
      {
        "name": "web_notredame",
